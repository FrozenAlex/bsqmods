---
import ModFilter from "../components/ModFilter.astro";
import DownloadMarkedModsLink from "../components/DownloadMarkedModsLink.astro";
import { MagnifyingGlassIcon } from "@heroicons/react/20/solid";

const { gameVersion } = Astro.props as {
  gameVersion: string;
};
---

<div
  class={`
    before:absolute
    before:backdrop-blur
    before:content-['']
    before:inset-0
    before:z-[-1]
    bg-header-footer-bg
    border-b
    border-card-border
    hidden
    mx-auto
    px-4
    py-3
    script-block
    shadow-lg
    sticky
    top-0
    w-full
    z-10
  `}
>
  <div class="mx-auto flex max-w-3xl flex-col items-stretch gap-3 sm:flex-row sm:items-center">
    <div class="relative min-w-0 flex-1">
      <MagnifyingGlassIcon
        className="pointer-events-none absolute top-1/2 left-3 z-[1] size-5 -translate-y-1/2 text-input-text/50"
        aria-hidden="true"
      />
      <ModFilter
        outerClass="block"
        class="field-input h-10 pl-10"
        placeholder="Search by name, author or description"
      />
    </div>
    <div class="qavs-none shrink-0 text-center">
      <DownloadMarkedModsLink
        version={gameVersion}
        outerClass="w-full sm:w-auto"
        class={`
          btn
          btn-primary
          disabled:bg-neutral
          h-10
          rounded-lg
          text-white
          w-full
        `}
      >
        Download Marked Mods
      </DownloadMarkedModsLink>
    </div>
  </div>
</div>
